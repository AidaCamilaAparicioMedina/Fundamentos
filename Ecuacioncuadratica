#include <iostream>
#include <cmath>
using namespace std;
int main()
{
    float a,b,c;
    double x1,x2;
    
    cout<<"Ingresar el coeficiente de x^2: "; cin>>a;
    cout<<"\nIngresar el coeficiente de x: "; cin>>b;
    cout<<"\nIngresar el termino independiente: "; cin>>c;
    
    x1=(-b+sqrt(b*b-4*a*c))/2*a;
    x2=(-b-sqrt(b*b-4*a*c))/2*a;
    
    cout<<"\nLa primera solucion es: "; cout<<x1;
    cout<<"\nLa segunda solucion es: "; cout<<x2;
    

    return 0;
}
