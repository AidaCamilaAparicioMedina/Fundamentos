bool validar_fecha(string fecha) {

    if (fecha.length() != 10 || fecha[2] != '/' || fecha[5] != '/')
        return false;

    for (int i = 0; i < 10; i++) {
        if (i != 2 && i != 5) {
            if (fecha[i] < '0' || fecha[i] > '9')
                return false;
        }
    }

    int dia = stoi(fecha.substr(0, 2));
    int mes = stoi(fecha.substr(3, 2));
    int anio = stoi(fecha.substr(6, 4));

    if (anio < 1)
        return false;

    if (mes < 1 || mes > 12)
        return false;

    int dias;

    if (mes == 2) {
        if (anio % 400 == 0 || (anio % 4 == 0 && anio % 100 != 0))
            dias = 29;
        else
            dias = 28;
    }
    else if (mes == 4 || mes == 6 || mes == 9 || mes == 11)
        dias = 30;
    else
        dias = 31;

    if (dia < 1 || dia > dias)
        return false;

    return true;
}

void registrar_usuarios(string usuarios[], string contrasena[], int &n) {

    cout << "\n--- REGISTRAR USUARIO ---" << endl;

    if (n == MAX) {
        cout << "No se pueden registrar mas usuarios." << endl;
        return;
    }

    string usuario;

    cout << "Ingrese usuario: ";
    cin >> usuario;

    for (int i = 0; i < n; i++) {
        if (usuarios[i] == usuario) {
            cout << "El usuario ya existe." << endl;
            return;
        }
    }

    cout << "Ingrese contrasena: ";
    cin >> contrasena[n];

    usuarios[n] = usuario;
    n++;

    cout << "Usuario registrado correctamente." << endl;
}

void listar_usuarios(string usuarios[], int n) {

    cout << "\n--- LISTA DE USUARIOS ---" << endl;

    if (n == 0)
        cout << "No hay usuarios registrados." << endl;

    else {
        for (int i = 0; i < n; i++) {
            cout << "\nUsuario Nro: " << i + 1 << endl;
            cout << "Usuario: " << usuarios[i] << endl;
        }
    }
}

void modificar_usuarios(string usuarios[], string contrasena[], int n) {

    cout << "\n--- MODIFICAR USUARIO ---" << endl;

    string nombre;

    cout << "Ingrese el usuario que desea modificar: ";
    cin >> nombre;

    for (int i = 0; i < n; i++) {
        if (usuarios[i] == nombre) {

            string nuevo;

            cout << "Nuevo nombre de usuario: ";
            cin >> nuevo;

            for (int j = 0; j < n; j++) {
                if (usuarios[j] == nuevo && j != i) {
                    cout << "El usuario ya existe." << endl;
                    return;
                }
            }

            usuarios[i] = nuevo;

            cout << "Nueva contrasena: ";
            cin >> contrasena[i];

            cout << "Usuario modificado correctamente." << endl;
            return;
        }
    }

    cout << "Usuario no encontrado." << endl;
}

void borrar_usuario(string usuarios[], string contrasena[], int &n) {

    cout << "\n--- BORRAR USUARIO ---" << endl;

    string nombre;

    cout << "Ingrese el usuario que desea eliminar: ";
    cin >> nombre;

    for (int i = 0; i < n; i++) {
        if (usuarios[i] == nombre) {

            for (int j = i; j < n - 1; j++) {
                usuarios[j] = usuarios[j + 1];
                contrasena[j] = contrasena[j + 1];
            }

            n--;

            cout << "Usuario eliminado correctamente." << endl;
            return;
        }
    }

    cout << "Usuario no encontrado." << endl;
}

bool login(string usuarios[], string contrasena[], int n) {

    cout << "\n--- INICIAR SESION ---" << endl;

    string usuario, clave;

    cout << "Usuario: ";
    cin >> usuario;

    cout << "Contrasena: ";
    cin >> clave;

    for (int i = 0; i < n; i++) {
        if (usuarios[i] == usuario && contrasena[i] == clave) {
            cout << "Bienvenido " << usuario << endl;
            return true;
        }
    }

    cout << "Usuario o contrasena incorrectos." << endl;
    return false;
}

