#include <iostream>
#include <cmath>
using namespace std;

int main()
{
    int count=1,n,suma=0;

    cout<<"Introduce el ultimo numero a sumar: ";
    cin>>n;
    cout<<"S = ";

    for (int count = 1; count <= n; count++) {
        suma += pow(count, 2);
        cout << count << "²";

        if (count<n)
            cout<<" + ";
    }

    cout<<" = "<<suma<< endl;

    return 0;
}
