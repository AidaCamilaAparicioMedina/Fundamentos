#include <iostream>
#include <cmath>
using namespace std;

int main()
{
    bool flag=true;
    int n,cont=2,cont2=0,opcion;

    do {
        int cont=2,cont2=0;
        cout<<"Ingrese el N primos a generar: ";
        cin>>n;
        while(cont2<n)
        {
        flag=true;
        for (int i=2 ;i<=sqrt(cont);i++)
            if (cont%i==0){
               flag=false;
               break;
            }
         
            if (flag){
                cout<<cont<<" , ";
                cont2++;
            }
            cont++;
        }
            cout<<"\nPresiona 0 para salir del programa"<<endl;
            cout<<"Presiona cualquier numero para ejecutar el programa de nuevo "<<endl;
            cin>>opcion;
    }while (opcion != 0);
    
    
    return 0;
}
