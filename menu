#include <iostream>

using namespace std;

int main()
{
    int a,b,opcion=0,r;
    cout<<"Ingresa el primer valor: ";
    cin>>a;
    cout<<"Ingresa el segundo valor: ";
    cin>>b;
    cout<<"--------Menu--------"<<endl;
    cout<<"1.- Suma"<<endl;
    cout<<"2.- Resta"<<endl;
    cout<<"3.- Multiplicacion"<<endl;
    cout<<"4.- Division"<<endl;
    cout<<"0.- Salir"<<endl;
    cout<<"Ingresa la opcion: "<<endl;
    cin>>opcion;
    switch(opcion){
        case 1:
         r=a+b;
         cout<<"El resultado es: "<<r;
         break;
        case 2:
         r=a-b;
         cout<<"El resultado es: "<<r;
         break;
        case 3:
         r=a*b;
         cout<<"El resultado es: "<<r;
         break;
        case 4:
         r=a/b;
         cout<<"El resultado es: "<<r;
         break;
        case 0:
         cout<<"Has salido del programa"<<endl;
         break;
        default:
         cout<<"Opcion invalida "<<endl;
    }
    
    return 0;
}
